# ==============================================================================
# CoSave Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env

# Host port mapping for CoSave web interface and API (Default: 5172)
# Change this if port 5172 is already in use on your host machine.
HOST_PORT=5172

# Host user and group IDs for container execution & volume file permissions
# Run `id -u` and `id -g` in your host terminal to check your user IDs.
COSAVE_UID=1000
COSAVE_GID=1000

# Container timezone (e.g. UTC, America/New_York, Europe/London, Asia/Kolkata)
TZ=UTC

# Logging level (options: error, warn, info, debug, trace)
RUST_LOG=cosave=info,tower_http=info
