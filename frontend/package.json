{
  "name": "cosave-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npx @laststance/tailwind-suggest-canonical-classes --check \"src/**/*.{astro,css,html,js,jsx,md,mdx,ts,tsx,vue,svelte}\" \"!src/lib/components/ui/**\"",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "npx @laststance/tailwind-suggest-canonical-classes \"src/**/*.{astro,css,html,js,jsx,md,mdx,ts,tsx,vue,svelte}\" \"!src/lib/components/ui/**\" && prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucide/svelte": "^1.46.0",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@laststance/tailwind-suggest-canonical-classes": "^0.1.2",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.1",
    "bits-ui": "^2.19.2",
    "cn": "^0.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-svelte": "^1.6.1",
    "svelte-check": "^4.7.6",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
